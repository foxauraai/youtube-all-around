{
  "manifest_version": 2,
  "name": "YouTube All Around",
  "version": "2.1.4",
  "description": "YouTube All Around, built by Foxaura AI, lets you watch YouTube videos in a floating, resizable, and movable mini-window while browsing other websites or working on different tasks.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubeallaround@foxauraai.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "https://www.youtube.com/*"
  ],
  "browser_action": {
    "default_title": "YouTube All Around",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "developer": {
    "name": "Foxaura AI",
    "url": "https://foxauraai.com/"
  },
  "homepage_url": "https://foxauraai.com/"
}
